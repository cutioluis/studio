{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceciglam-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ceciglam-web" }],
  // ISR page store. Create it once: wrangler r2 bucket create ceciglam-web-opennext-cache
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ceciglam-web-opennext-cache" }],
  // Background revalidation queue and revalidatePath tag store. Created automatically by the migration below.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  // next/image optimization (resize + WebP/AVIF) for /_next/image.
  "images": { "binding": "IMAGES" },
  // Public domains (DNS records and certificates are managed by Cloudflare).
  "routes": [
    { "pattern": "ceciglam.com", "custom_domain": true },
    { "pattern": "www.ceciglam.com", "custom_domain": true }
  ]
}
