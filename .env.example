SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated origins of the admin app allowed to call POST /api/revalidate (CORS). No wildcards.
# Example: https://ceciglam-admin-app.ceciglam.workers.dev,http://localhost:5173
ADMIN_ORIGINS=

# Resend API key for the course welcome email (secret; set in Cloudflare, never commit a real value).
RESEND_API_KEY=
# Optional sender. Defaults to "Ceciglam <hola@ceciglam.com>".
EMAIL_FROM=Ceciglam <hola@ceciglam.com>
